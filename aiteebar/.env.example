# ============================================================================
# AITEEBAR AI SECURITY - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and update values for your environment
# DO NOT COMMIT .env to version control (it contains secrets!)
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================================
POSTGRES_USER=aiteebar
POSTGRES_PASSWORD=aiteebar_password
POSTGRES_DB=aiteebar_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aiteebar:aiteebar_password@postgres:5432/aiteebar_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============================================================================
# BACKEND CONFIGURATION (FastAPI)
# ============================================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_WORKERS=4
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development

# ============================================================================
# FRONTEND CONFIGURATION (Next.js)
# ============================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Aiteebar AI Security
FRONTEND_PORT=3000
NODE_ENV=development

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================
# JWT Configuration
JWT_SECRET_KEY=change-me-in-production-32-chars-min
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# OAuth2 Configuration (Optional)
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret
OAUTH_GITHUB_CLIENT_ID=your-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=your-github-client-secret

# Encryption (AES-256)
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000

# ============================================================================
# REDIS CONFIGURATION (Caching & Sessions)
# ============================================================================
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=redis_password
REDIS_PORT=6379

# ============================================================================
# OLLAMA CONFIGURATION (AI Model Runtime)
# ============================================================================
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_PORT=11434
# Available models: llama2, mistral, neural-chat, etc.
OLLAMA_MODEL=mistral

# ============================================================================
# AI/ML CONFIGURATION
# ============================================================================
# OpenAI API (Optional - for advanced AI features)
OPENAI_API_KEY=sk-your-api-key
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# Local Model Configuration
USE_LOCAL_MODELS=true
LOCAL_MODEL_PROVIDER=ollama

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@aiteebar.ai
SENDER_NAME=Aiteebar AI Security

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_BURST=50

# ============================================================================
# API CONFIGURATION
# ============================================================================
API_VERSION=v1
API_TITLE=Aiteebar AI Security API
API_DESCRIPTION=AI-powered security analysis and threat intelligence platform
API_DOCS_ENABLED=true

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================
# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Sentry (Error tracking - optional)
SENTRY_DSN=

# ============================================================================
# SECURITY SCANNING CONFIGURATION
# ============================================================================
# Scanning timeouts and limits
SCAN_TIMEOUT_MINUTES=30
MAX_CONCURRENT_SCANS=5
MAX_TARGETS_PER_SCAN=100

# Threat intelligence sources
ENABLE_CVES_SYNC=true
ENABLE_DARKWEB_MONITORING=false
ENABLE_THREAT_FEEDS=true

# ============================================================================
# DOCKER CONFIGURATION
# ============================================================================
# Docker Compose profiles (uncomment to enable optional services)
# COMPOSE_PROFILES=with-ollama,with-redis,with-adminer

# Adminer (Database UI - Development only)
ADMINER_PORT=8080

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================
# Enable debug mode (DO NOT use in production)
DEBUG=true
DEBUG_SQL=false
DEBUG_PROFILER=false

# File upload settings
MAX_UPLOAD_SIZE_MB=100
ALLOWED_FILE_TYPES=.pdf,.txt,.json,.csv,.log

# ============================================================================
# PRODUCTION SETTINGS (Override for production deployment)
# ============================================================================
# Uncomment and set for production:
# ENVIRONMENT=production
# BACKEND_DEBUG=false
# NODE_ENV=production
# BACKEND_WORKERS=8
# RATE_LIMIT_REQUESTS=5000
# CORS_ORIGINS=https://yourdomain.com
# NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api

# ============================================================================
# ADVANCED CONFIGURATION (Expert users only)
# ============================================================================
# Database connection pooling
DB_ECHO=false
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# Celery Configuration (for async tasks)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Feature flags
FEATURE_API_DOCS=true
FEATURE_HEALTH_CHECK=true
FEATURE_METRICS=true

# ============================================================================
# NOTES
# ============================================================================
# - Keep production secrets in a secure secret manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# - Never commit .env file to version control
# - Update JWT_SECRET_KEY with a strong random value in production
# - For OAuth, register your application with the provider (Google, GitHub, etc.)
# - For email, use an app password or OAuth if available
# - Adjust rate limits based on your infrastructure capacity
# - In production, use environment variables from secure sources, not .env files
