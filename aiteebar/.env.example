# Database Configuration
DATABASE_URL=postgresql://aiteebar:aiteebar_password@localhost:5432/aiteebar_db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Backend (FastAPI) Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_DEBUG=true
BACKEND_WORKERS=4

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=Aiteebar AI Security
NODE_ENV=development

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Authentication
OAUTH_GOOGLE_CLIENT_ID=your-google-client-id
OAUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SENDER_EMAIL=noreply@aiteebar.ai

# Redis Configuration (for caching & rate limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# AI/ML Configuration
OPENAI_API_KEY=your-openai-api-key
MODEL_NAME=gpt-4
EMBEDDING_MODEL=text-embedding-3-small

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Docker
POSTGRES_USER=aiteebar
POSTGRES_PASSWORD=aiteebar_password
POSTGRES_DB=aiteebar_db

# Environment
ENVIRONMENT=development
